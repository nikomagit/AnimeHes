{
  "name": "amokin",
  "version": "2.0.0",
  "description": "AMOKIN: catálogos Hentaila y streams HTTP directos de anime, películas y series para Nuvio/Stremio.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:live": "tsx scripts/validate-live.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "dotenv": "17.4.2",
    "fastify": "5.12.1"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
