# El addon funciona con IMDb y Kitsu sin claves.
# Solo necesitas una de estas dos variables si Nuvio envía IDs tmdb:...
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=

HOST=0.0.0.0
PORT=7100
LOG_LEVEL=info
HENTAILA_BASE_URL=https://hentaila.com
METADATA_BASE_URL=https://v3-cinemeta.strem.io
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_LANGUAGE=en-US

# Ajustes opcionales y conservadores.
REQUEST_TIMEOUT_MS=10000
METADATA_TIMEOUT_MS=6000
SEARCH_CACHE_TTL_MS=60000
METADATA_CACHE_TTL_MS=86400000
MEDIA_CACHE_TTL_MS=21600000
MAX_SEARCH_QUERIES=4
MAX_CANDIDATES=5
MAX_STREAMS=3
MIN_MATCH_SCORE=0.72
