# IMDb, TMDB y Kitsu funcionan sin claves privadas.
# Una clave TMDB opcional agrega títulos localizados y alternativos; nunca la publiques en Git.
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_LANGUAGE=es-ES

HOST=0.0.0.0
PORT=7100
LOG_LEVEL=info
HENTAILA_BASE_URL=https://hentaila.com
HENTAILA_CDN_BASE_URL=https://cdn.hentaila.com
ANIMEAV1_BASE_URL=https://animeav1.com
ANIMEAV1_CDN_BASE_URL=https://cdn.animeav1.com
JKANIME_BASE_URL=https://jkanime.net
CUEVANA_BASE_URL=https://cuevana3l.biz
LAMOVIE_BASE_URL=https://lamovie.org
METADATA_BASE_URL=https://v3-cinemeta.strem.io
METADATA_FALLBACK_BASE_URL=https://94c8cb9f702d-tmdb-addon.baby-beamup.club

# Ajustes opcionales y conservadores.
REQUEST_TIMEOUT_MS=10000
METADATA_TIMEOUT_MS=6000
SEARCH_CACHE_TTL_MS=60000
CATALOG_CACHE_TTL_MS=900000
METADATA_CACHE_TTL_MS=86400000
MEDIA_CACHE_TTL_MS=21600000
MAX_SEARCH_QUERIES=4
MAX_CANDIDATES=5
MAX_STREAMS=8
MIN_MATCH_SCORE=0.72
